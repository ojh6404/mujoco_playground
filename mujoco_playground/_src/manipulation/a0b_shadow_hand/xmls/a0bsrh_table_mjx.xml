<mujoco model="a0b_shadow_hand_table">
  <!-- Same as a0bsrh_mjx.xml, but the forearm and hand adaptor collide with geoms whose conaffinity has bit 2 (the table). -->
  <!--
    A0B arm with a Shadow Hand (a0bsrh_model, JSK), adapted for MJX:
    mesh assets are referenced by file name, arm links do not collide, and the
    0.5 mm contact margins are removed (MJX does not support margins on mesh
    contacts). Joint, tendon, contact-pair and actuator definitions are the
    original ones.
  -->
