        <default class="robot0:asset_class">
            <geom friction="0.05" condim="4" margin="0" contype="1" conaffinity="1"/>
            <joint limited="true" damping="0.1" armature="0.001" margin="0.01" frictionloss="0.001"/>
            <site size="0.005" rgba="0.4 0.9 0.4 1"/>
            <general ctrllimited="true" forcelimited="true"/>
        </default>
        <default class="robot0:D_Touch">
            <site type="box" size="0.009 0.004 0.013" pos="0 -0.004 0.018" rgba="0.8 0.8 0.8 0.15" group="4"/>
        </default>
        <default class="robot0:DC_Hand">
            <geom material="robot0:MatColl" condim="4" friction="0.05" contype="1" conaffinity="0" group="4"/>
        </default>
        <default class="robot0:D_Visual">
            <geom material="robot0:MatViz" contype="0" conaffinity="0" group="1" type="mesh"/>
        </default>
    </default>

