<mujoco model="rebot_b601_dm">
  <!--
    reBot Arm B601-DM (Damiao 4340P on joint1-3, 4310 on joint4-6 and gripper).

    Kinematics, inertials, joint ranges and effort limits follow
    DM/urdf/ReBot_Arm_DM.urdf from https://github.com/Yang-Ci/Rebot_Arm_description.
    Visual meshes come from DM/meshes/{visual,shared}. For MJX speed, contacts
    use boxes fitted to the gripper base and the front/mid finger segments of
    DM/meshes/mujoco_collision; arm links do not collide.

    The DM firmware tracks POS_VEL targets with an internal PID, so the arm is
    modeled as gravity-compensated position servos. Gains are the DM MuJoCo
    physics-grasp PD gains (rebotarm_mujoco/mujoco_physics_grasp.py), clamped
    to the URDF effort limits.
  -->
  <compiler angle="radian" eulerseq="XYZ" autolimits="true"/>

  <default>
    <default class="rebot">
      <joint damping="0.8" armature="0.01"/>
      <site group="4"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="box" group="3" condim="3" friction="1.5 0.03 0.003"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="anodized_grey" rgba="0.831 0.847 0.831 1" specular="0.5" shininess="0.6"/>
    <material name="silver_trim" rgba="0.878 0.890 0.875 1" specular="0.5" shininess="0.6"/>
    <material name="hardware_black" rgba="0.020 0.027 0.024 1" specular="0.4" shininess="0.5"/>
    <material name="matte_black" rgba="0.067 0.075 0.071 1" specular="0.2" shininess="0.2"/>
    <material name="seeed_yellow" rgba="0.73 0.84 0.12 1" specular="0.2" shininess="0.2"/>
    <material name="carriage_grey" rgba="0.239 0.278 0.271 1" specular="0.3" shininess="0.3"/>

    <mesh file="colored_base_link_hardware_black.stl"/>
    <mesh file="colored_base_link_matte_black.stl"/>
    <mesh file="colored_base_link_silver_trim.stl"/>
    <mesh file="colored_link1_anodized_grey.stl"/>
    <mesh file="colored_link1_hardware_black.stl"/>
    <mesh file="colored_link1_matte_black.stl"/>
    <mesh file="colored_link2_anodized_grey.stl"/>
    <mesh file="colored_link2_hardware_black.stl"/>
    <mesh file="colored_link2_matte_black.stl"/>
    <mesh file="colored_link2_seeed_yellow.stl"/>
    <mesh file="colored_link3_anodized_grey.stl"/>
    <mesh file="colored_link3_hardware_black.stl"/>
    <mesh file="colored_link3_matte_black.stl"/>
    <mesh file="colored_link3_seeed_yellow.stl"/>
    <mesh file="colored_link4_anodized_grey.stl"/>
    <mesh file="colored_link4_hardware_black.stl"/>
    <mesh file="colored_link4_matte_black.stl"/>
    <mesh file="colored_link4_seeed_yellow.stl"/>
    <mesh file="colored_link5_anodized_grey.stl"/>
    <mesh file="colored_link5_hardware_black.stl"/>
    <mesh file="colored_link5_matte_black.stl"/>
    <mesh file="colored_link6_hardware_black.stl"/>
    <mesh file="colored_link6_matte_black.stl"/>
    <mesh file="colored_gripper_base_hardware_black.stl"/>
    <mesh file="colored_gripper_base_metal.stl"/>
    <mesh file="colored_gripper_base_seeed_yellow.stl"/>
    <mesh file="colored_left_finger_finger_black.stl"/>
    <mesh file="colored_left_finger_carriage_grey.stl"/>
    <mesh file="colored_left_finger_travel_stop_yellow.stl"/>
    <mesh file="colored_left_finger_rack_metal.stl"/>
    <mesh file="colored_right_finger_finger_black.stl"/>
    <mesh file="colored_right_finger_carriage_grey.stl"/>
    <mesh file="colored_right_finger_travel_stop_yellow.stl"/>
    <mesh file="colored_right_finger_rack_metal.stl"/>
  </asset>

  <worldbody>
    <body name="base_link" childclass="rebot">
      <inertial pos="-7.849e-06 -1.1531e-06 0.029841" mass="0.8366"
        fullinertia="0.0013304 0.00213119 0.00275877 1e-08 0 0"/>
      <geom class="visual" mesh="colored_base_link_hardware_black" material="hardware_black"/>
      <geom class="visual" mesh="colored_base_link_matte_black" material="matte_black"/>
      <geom class="visual" mesh="colored_base_link_silver_trim" material="silver_trim"/>

      <body name="link1" pos="-8.416e-05 0 0.08465" gravcomp="1">
        <joint name="joint1" axis="0 0 1" range="-2.8 2.8"/>
        <inertial pos="0.000113614552951627 -0.000616319527051323 0.0236476372671394" mass="0.1613"
          fullinertia="0.00025207 0.00015464 0.00023416 0 -2.832e-05 0"/>
        <geom class="visual" mesh="colored_link1_anodized_grey" material="anodized_grey"/>
        <geom class="visual" mesh="colored_link1_hardware_black" material="hardware_black"/>
        <geom class="visual" mesh="colored_link1_matte_black" material="matte_black"/>

        <body name="link2" pos="0.020084 0.031625 0.05555" euler="-1.5708 0 0" gravcomp="1">
          <joint name="joint2" axis="0 0 -1" range="-3.14 0"/>
          <inertial pos="-0.13225622308888 -0.0030617036386309 -0.0308306967030205" mass="1.3266"
            fullinertia="0.00073374 0.01255987 0.01281387 -4.3e-07 8.51e-06 1.28e-06"/>
          <geom class="visual" mesh="colored_link2_anodized_grey" material="anodized_grey"/>
          <geom class="visual" mesh="colored_link2_hardware_black" material="hardware_black"/>
          <geom class="visual" mesh="colored_link2_matte_black" material="matte_black"/>
          <geom class="visual" mesh="colored_link2_seeed_yellow" material="seeed_yellow"/>

          <body name="link3" pos="-0.264 0 0" gravcomp="1">
            <joint name="joint3" axis="0 0 1" range="-3.14 0"/>
            <inertial pos="0.121040035791843 -0.0536211076627949 -0.0310137854608077" mass="0.8353"
              fullinertia="0.00046807 0.00632695 0.00648221 -3.456e-05 -4.26e-05 6e-08"/>
            <geom class="visual" mesh="colored_link3_anodized_grey" material="anodized_grey"/>
            <geom class="visual" mesh="colored_link3_hardware_black" material="hardware_black"/>
            <geom class="visual" mesh="colored_link3_matte_black" material="matte_black"/>
            <geom class="visual" mesh="colored_link3_seeed_yellow" material="seeed_yellow"/>

            <body name="link4" pos="0.2426 -0.054 -0.001625" gravcomp="1">
              <joint name="joint4" axis="0 0 1" range="-1.87 1.57"/>
              <inertial pos="0.0608200956293136 -0.0511711906613122 -0.030299458623927" mass="0.52"
                fullinertia="0.00045986 0.00075258 0.00066742 0.00024219 -6.72e-06 -5.35e-06"/>
              <geom class="visual" mesh="colored_link4_anodized_grey" material="anodized_grey"/>
              <geom class="visual" mesh="colored_link4_hardware_black" material="hardware_black"/>
              <geom class="visual" mesh="colored_link4_matte_black" material="matte_black"/>
              <!-- The URDF renders this part with the matte black material. -->
              <geom class="visual" mesh="colored_link4_seeed_yellow" material="matte_black"/>

              <body name="link5" pos="0.078308 -0.0375 -0.03" euler="-1.5708 0 0" gravcomp="1">
                <joint name="joint5" axis="0 0 1" range="-1.57 1.57"/>
                <inertial pos="-0.00502802058982517 1.73866206692364e-06 0.0386233236326755" mass="0.383"
                  fullinertia="0.00019772 0.00021737 0.00017191 -6.2e-07 -2.426e-05 2e-08"/>
                <geom class="visual" mesh="colored_link5_anodized_grey" material="anodized_grey"/>
                <geom class="visual" mesh="colored_link5_hardware_black" material="hardware_black"/>
                <geom class="visual" mesh="colored_link5_matte_black" material="matte_black"/>

                <body name="link6" pos="0.028008 0 0.04" euler="0 1.5708 0" gravcomp="1">
                  <joint name="joint6" axis="0 0 1" range="-3.14 3.14"/>
                  <inertial pos="3.76418727127126e-06 -0.000100908819946677 0.0253308606425965" mass="0.3663"
                    fullinertia="0.00015554 0.00015554 0.00013966 0 0 0"/>
                  <geom class="visual" mesh="colored_link6_hardware_black" material="hardware_black"/>
                  <geom class="visual" mesh="colored_link6_matte_black" material="matte_black"/>

                  <!-- Gripper frame: +x points from the gripper base toward the fingertips
                       (fingertips at x=0), fingers slide along y. -->
                  <body name="end_link" pos="0 0 0.15539" euler="0 -1.5708 3.1415" gravcomp="1">
                    <inertial pos="-0.0737654295815033 -9.5080995865868e-06 7.04327840286845e-06" mass="0.5"
                      fullinertia="0.00037354 0.0001583 0.00045353 -1.1e-07 5e-07 3.48e-06"/>
                    <geom class="visual" mesh="colored_gripper_base_hardware_black" material="hardware_black"/>
                    <geom class="visual" mesh="colored_gripper_base_metal" material="anodized_grey"/>
                    <geom class="visual" mesh="colored_gripper_base_seeed_yellow" material="seeed_yellow"/>
                    <geom name="hand_box" class="collision" pos="-0.08995 0 0" size="0.01675 0.092 0.0342"/>
                    <!-- Grasp center, on the front finger segment. -->
                    <site name="gripper" pos="-0.015 0 0" size="0.005"/>

                    <body name="finger_left_link" gravcomp="1">
                      <joint name="finger_left" type="slide" axis="0 1 0" range="0 0.05"/>
                      <inertial pos="0 0 0" mass="0.03" diaginertia="1e-05 1e-05 1e-05"/>
                      <geom class="visual" mesh="colored_left_finger_finger_black" material="matte_black"/>
                      <geom class="visual" mesh="colored_left_finger_carriage_grey" material="carriage_grey"/>
                      <geom class="visual" mesh="colored_left_finger_travel_stop_yellow" material="seeed_yellow"/>
                      <geom class="visual" mesh="colored_left_finger_rack_metal" material="anodized_grey"/>
                      <geom name="left_finger_pad" class="collision" pos="-0.0245 0.0071 0" size="0.0245 0.0071 0.0135"/>
                    </body>

                    <body name="finger_right_link" gravcomp="1">
                      <joint name="finger_right" type="slide" axis="0 1 0" range="-0.05 0"/>
                      <inertial pos="0 0 0" mass="0.03" diaginertia="1e-05 1e-05 1e-05"/>
                      <geom class="visual" mesh="colored_right_finger_finger_black" material="matte_black"/>
                      <geom class="visual" mesh="colored_right_finger_carriage_grey" material="carriage_grey"/>
                      <geom class="visual" mesh="colored_right_finger_travel_stop_yellow" material="seeed_yellow"/>
                      <geom class="visual" mesh="colored_right_finger_rack_metal" material="anodized_grey"/>
                      <geom name="right_finger_pad" class="collision" pos="-0.0245 -0.0071 0" size="0.0245 0.0071 0.0135"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="finger_left_link" body2="finger_right_link"/>
  </contact>

  <equality>
    <!-- URDF mimic: finger_right = -finger_left. -->
    <joint joint1="finger_right" joint2="finger_left" polycoef="0 -1 0 0 0"
      solref="0.01 1" solimp="0.95 0.99 0.001"/>
  </equality>

  <actuator>
    <position name="joint1" joint="joint1" kp="140" kv="7" ctrlrange="-2.8 2.8" forcerange="-27 27"/>
    <position name="joint2" joint="joint2" kp="140" kv="7" ctrlrange="-3.14 0" forcerange="-27 27"/>
    <position name="joint3" joint="joint3" kp="110" kv="5.5" ctrlrange="-3.14 0" forcerange="-27 27"/>
    <position name="joint4" joint="joint4" kp="55" kv="2.5" ctrlrange="-1.87 1.57" forcerange="-7 7"/>
    <position name="joint5" joint="joint5" kp="38" kv="1.8" ctrlrange="-1.57 1.57" forcerange="-7 7"/>
    <position name="joint6" joint="joint6" kp="28" kv="1.4" ctrlrange="-3.14 3.14" forcerange="-7 7"/>
    <!-- Finger position in meters: 0 closed, 0.05 fully open (100 mm opening). -->
    <position name="gripper" joint="finger_left" kp="1800" kv="18" ctrlrange="0 0.05" forcerange="-8 8"/>
  </actuator>
</mujoco>
