<mujoco model="i2rt_yam single cube camera">
  <include file="yam.xml"/>
  <!-- Like mjx_scene.xml, with a darker scene, a single light and a front camera. -->
  <statistic center="0.25 0 0.15" extent="0.7"/>

  <option timestep="0.005" iterations="5" ls_iterations="8" integrator="implicitfast">
    <flag eulerdamp="disable"/>
  </option>

  <custom>
    <numeric data="12" name="max_contact_points"/>
  </custom>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
    <scale contactwidth="0.075" contactheight="0.025" forcewidth="0.05" com="0.05" framewidth="0.01" framelength="0.2"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="top" pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- Faces the robot from the front, looking down at the spawn line. -->
    <camera name="front" fovy="42" pos="0.85 0 0.45" xyaxes="0 1 0 -0.523 0 0.852"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1"/>
    <!-- Box spawn line. -->
    <geom name="init_space" size="0.02 1 0.01" type="plane" pos="0.28 0 0.001" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <body name="box" pos="0.28 0 0.03">
      <freejoint/>
      <geom type="box" name="box" size="0.02 0.02 0.03" condim="3" mass="0.05"
       friction="1 .03 .003" rgba="1 0 0 1" solref="0.01 1"/>
    </body>
    <body mocap="true" name="mocap_target">
      <!-- Group 3 is not rendered, so the target never shows up in pixels. -->
      <geom type="box" size="0.02 0.02 0.03" rgba="1 0 0 0.2" contype="0" conaffinity="0" group="3"/>
    </body>
  </worldbody>

  <include file="sensor.xml"/>

  <keyframe>
    <!-- Gripper pointing down 10 cm above the spawn line, fingers open to 80 mm. -->
    <key name="low_home"
      qpos="0 1.7682 1.5139 -1.3165 0 0 0.04 -0.04 0.28 0 0.03 1 0 0 0"
      ctrl="0 1.7682 1.5139 -1.3165 0 0 0.04"/>
    <!-- Box held at the low_home gripper position. -->
    <key name="picked"
      qpos="0 1.7701 1.5125 -1.3154 0 0 0.016 -0.0163 0.2801 -0.0001 0.1251 0.9997 0 -0.0239 0"
      ctrl="0 1.7701 1.5125 -1.3154 0 0 0"/>
  </keyframe>
</mujoco>
